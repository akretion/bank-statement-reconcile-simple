<odoo>

<record id="res_config_settings_view_form" model="ir.ui.view">
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="account.res_config_settings_view_form" />
    <field name="arch" type="xml">
        <block id="bank_cash" position="inside">
            <setting
                    id="statement_autocompletion_partner_name_min_size"
                    help="When Partner Name Completion is enabled on a bank journal, partners that have a name smaller than the number of caracters configured here will be excluded from that feature."
